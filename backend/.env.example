# Copy to .env and run commands from the backend directory.
# Replace the credentials, port, and database with your local-infra settings.
DATABASE_URL=postgres://YOUR_USER:YOUR_PASSWORD@localhost:5432/micro_ci?sslmode=disable

ENV=development
DATABASE_QUERY_TIMEOUT=3s
SHUTDOWN_TIMEOUT=3s

# Worker identity is generated at startup.
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL=1s
WORKER_LEASE_DURATION=30s
WORKER_HEARTBEAT_INTERVAL=5s
WORKER_PREPARATION_TIMEOUT=5m
WORKER_CLEANUP_TIMEOUT=10s
WORKER_WORKSPACE_ROOT=/tmp/micro-ci/workspaces

# These values provide defaults; command-line flags override them.
# The HTTP port is configured with -port (default: 4000).
